model UserLevelProgress {
  id                   String             @id @default(uuid()) @db.Uuid
  userIslandProgressId String             @db.Uuid
  levelId              String             @db.Uuid
  currentSlideId       String             @db.Uuid
  startedAt            DateTime           @default(now())
  completedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  userIslandProgress   UserIslandProgress @relation(fields: [userIslandProgressId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  level                Level              @relation("ProgressLevel", fields: [levelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentSlide         Slide              @relation("CurrentSlide", fields: [currentSlideId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userIslandProgressId, levelId])
  @@index([currentSlideId])
}
