model Level {
  id                      String               @id @default(uuid()) @db.Uuid
  islandId                String               @db.Uuid
  title                   String
  position                Int
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  island                  Island               @relation(fields: [islandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  slides                  Slide[]
  currentByIslandProgress UserIslandProgress[] @relation("CurrentLevel")
  levelProgress           UserLevelProgress[]  @relation("ProgressLevel")

  @@unique([islandId, position])
}
