model Slide {
  id                     String              @id @default(uuid()) @db.Uuid
  levelId                String              @db.Uuid
  title                  String
  type                   SlideType
  position               Int
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  level                  Level               @relation(fields: [levelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  textText               TextTextSlide?
  textImage              TextImageSlide?
  textCode               TextCodeSlide?
  currentByLevelProgress UserLevelProgress[] @relation("CurrentSlide")

  @@unique([levelId, position])
}
