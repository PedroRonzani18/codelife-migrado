model UserTrailProgress {
  id                   String               @id @default(uuid()) @db.Uuid
  userId               String               @db.Uuid
  trailId              String               @db.Uuid
  currentTrailIslandId String               @db.Uuid
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  trail                Trail                @relation(fields: [trailId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentTrailIsland   TrailIsland          @relation("CurrentTrailIsland", fields: [currentTrailIslandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  islands              UserIslandProgress[]

  @@unique([userId, trailId])
  @@index([currentTrailIslandId])
}
