model MediaAsset {
  id          String           @id @default(uuid()) @db.Uuid
  objectKey   String           @unique
  mimeType    String
  sizeBytes   Int?
  width       Int?
  height      Int?
  checksum    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  imageSlides TextImageSlide[]
}
