model UserIslandProgress {
  id                   String             @id @default(uuid()) @db.Uuid
  userTrailProgressId  String             @db.Uuid
  trailIslandId        String             @db.Uuid
  currentIslandLevelId String             @db.Uuid
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  userTrailProgress    UserTrailProgress  @relation(fields: [userTrailProgressId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  trailIsland          TrailIsland        @relation("ProgressTrailIsland", fields: [trailIslandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentIslandLevel   IslandLevel        @relation("CurrentIslandLevel", fields: [currentIslandLevelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  levels               UserLevelProgress[]

  @@unique([userTrailProgressId, trailIslandId])
  @@index([currentIslandLevelId])
}
