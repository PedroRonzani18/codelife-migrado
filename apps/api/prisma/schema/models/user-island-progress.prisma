model UserIslandProgress {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  islandId       String              @db.Uuid
  currentLevelId String              @db.Uuid
  startedAt      DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  island         Island              @relation(fields: [islandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentLevel   Level               @relation("CurrentLevel", fields: [currentLevelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  levels         UserLevelProgress[]

  @@unique([userId, islandId])
  @@index([currentLevelId])
}
