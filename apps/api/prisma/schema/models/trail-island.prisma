model TrailIsland {
  id                     String                @id @default(uuid()) @db.Uuid
  trailId                String                @db.Uuid
  islandId               String                @db.Uuid
  position               Int
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  trail                  Trail                 @relation(fields: [trailId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  island                 Island                @relation(fields: [islandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentByTrailProgress UserTrailProgress[]   @relation("CurrentTrailIsland")
  islandProgress         UserIslandProgress[]  @relation("ProgressTrailIsland")

  @@unique([trailId, position])
  @@index([islandId])
}
