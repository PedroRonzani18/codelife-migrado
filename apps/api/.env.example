# Banco local criado por `pnpm db:up`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/codelife?schema=public"
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-local-only-secret
JWT_EXPIRES_IN=8h
JWT_ISSUER=codelife-api
JWT_AUDIENCE=codelife-web
AUTH_COOKIE_NAME=codelife_experimental_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_MAX_AGE_SECONDS=28800
EXPERIMENTAL_LOGIN_ENABLED=true
SWAGGER_ENABLED=true
# Google OIDC is optional until the Google login flow is enabled.
# Never commit real credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
