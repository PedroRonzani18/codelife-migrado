{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/clean-dist.mjs && nest start --watch --env-file .env",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:cov": "jest --coverage --runInBand",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@codelife/contracts": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "ms": "2.1.3",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/ms": "2.1.0",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "eslint": "10.8.1",
    "eslint-config": "workspace:*",
    "globals": "17.11.0",
    "jest": "30.4.2",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.2",
    "tsconfig": "workspace:*",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
