{
  "extends": "tsconfig/base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@codelife/contracts": ["../../packages/contracts/src/index.ts"],
      "@codelife/contracts/*": ["../../packages/contracts/src/*.ts"]
    }
  },
  "include": ["src"]
}
