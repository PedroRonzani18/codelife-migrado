{
  "name": "@codelife/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "*": ["src/*.ts"]
    }
  },
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./*": { "types": "./src/*.ts", "default": "./src/*.ts" }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "zod": "3.25.76" },
  "devDependencies": {
    "eslint-config": "workspace:*",
    "tsconfig": "workspace:*",
    "@eslint/js": "9.32.0",
    "eslint": "9.32.0",
    "globals": "15.15.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.7"
  }
}
